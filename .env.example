# Required environment variables (names configurable in config.yaml).
# NEVER commit real values. Inject at runtime via your secret manager:
#   doppler run --project <project> --config <cfg> -- <command>

# OpenAI-compatible proxy (image extraction, reasoning, repair)
LLM_BASE_URL=https://your-llm-proxy.example/v1
LLM_API_KEY=

# Bifrost GenAI endpoint (video extraction — Gemini-native generateContent)
BIFROST_GENAI_BASE_URL=https://your-bifrost.example/genai/v1beta
BIFROST_API_KEY=

# ClickHouse (inventory pulls + entity loading) — used by loaders/ and your own pull scripts
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
# host/port are whatever your tunnel or network provides, e.g. http://127.0.0.1:8123
