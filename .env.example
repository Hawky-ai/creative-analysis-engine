# Required environment variables (names configurable in config.yaml).
# NEVER commit real values. Inject at runtime via your secret manager:
#   doppler run --project <project> --config <cfg> -- <command>

# OpenAI-compatible proxy (image extraction, reasoning, repair)
LLM_BASE_URL=https://your-llm-proxy.example/v1
LLM_API_KEY=

# Bifrost GenAI endpoint (video extraction — Gemini-native generateContent)
BIFROST_GENAI_BASE_URL=https://your-bifrost.example/genai/v1beta
BIFROST_API_KEY=

# ClickHouse (inventory pulls + entity loading) — used by loaders/ and your own pull scripts
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
# Where ClickHouse actually answers FROM THIS MACHINE. If you reach it through a tunnel this is
# the local end (http://127.0.0.1:8123) — NOT the cluster's internal address, which only
# resolves from inside the network.
CLICKHOUSE_HTTP=http://127.0.0.1:8123

# MongoDB — loaders/set_copilot_entities.py registers the facet list here, and nothing shows up
# in the UI until it does. Same rule as above: through a tunnel, point at the local end. A single
# forwarded port cannot see a replica set, so drop replicaSet= and add directConnection=true.
# Quote the value — these URIs contain & and ? which the shell would otherwise interpret.
MONGO_URI='mongodb://user:pass@127.0.0.1:27017/?authSource=admin&directConnection=true'
MONGO_DB_NAME=test
